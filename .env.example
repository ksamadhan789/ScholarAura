# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/elearning_events?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/elearning_events?schema=public"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# --- Google OAuth (Phase 1) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Same value as GOOGLE_CLIENT_ID, exposed to the client for Google One Tap.
# In Google Cloud Console, also add your site's origin (e.g.
# https://scholaraura.com) under this OAuth client's "Authorized JavaScript
# origins" — One Tap fails silently without it. Leave blank to disable One
# Tap; the regular "Continue with Google" button keeps working either way.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# --- Email (password reset) — https://resend.com ---
# Get an API key from the Resend dashboard. Until you verify your own domain
# there, EMAIL_FROM must stay "onboarding@resend.dev" (Resend's shared
# sending domain) — a from address on an unverified domain will be rejected.
RESEND_API_KEY=""
EMAIL_FROM="ScholarAura <onboarding@resend.dev>"
# Reply-To address for certificate-ready emails — can't be the From address
# itself since Resend can't send "from" an unverified personal domain like
# gmail.com, but a Reply-To works fine for any address. Defaults to
# scholaraura@gmail.com if unset.
CERTIFICATE_REPLY_TO_EMAIL="scholaraura@gmail.com"

# --- Razorpay (Phase 3, add later) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Settings -> Webhooks in the Razorpay dashboard -> add endpoint
# https://<your-domain>/api/webhooks/razorpay, subscribe to "payment.captured",
# copy the secret shown there (a value you set, not derived from the API keys).
RAZORPAY_WEBHOOK_SECRET=""

# --- Video CDN ---
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_TOKEN_KEY=""

# --- Google Sheets/Slides/Drive (event attendance sync + certificate generation) ---
# Create a Google Cloud service account, enable the Sheets/Slides/Drive APIs
# for it, download its JSON key, then base64-encode the whole file (e.g.
# `base64 -i key.json | tr -d '\n'`) and paste the result here — a raw
# multi-line JSON value doesn't survive most env var UIs intact.
GOOGLE_SERVICE_ACCOUNT_KEY=""
# Share each event's Google Sheet (Viewer) and any Slides certificate
# template (Viewer) with this service account's client_email for it to
# access them.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Parent Drive folder (owned by/shared with the service account, or the
# account connected below) generated certificates are organized under, as
# Certificates/{year}/{event-slug}/.
GOOGLE_DRIVE_ROOT_FOLDER_ID=""
# A bare service account has zero Drive storage quota on a non-Workspace
# account, so file-creating calls (copying the template, uploading the
# final PDF) fail with a quota error even when shared into a folder that
# has room. The fix is a dedicated OAuth client an admin connects their own
# Google account to (via the "Connect Google Drive" button on an event's
# Certificates page) so those calls run under that account's real quota
# instead. Create this Client ID under Google Cloud Console -> Credentials
# -> Create credentials -> OAuth client ID -> Web application, with
# {SITE_URL}/api/admin/google-drive/callback as an Authorized redirect URI.
# Deliberately separate from GOOGLE_CLIENT_ID/SECRET (the site's sign-in
# client) so this narrower Drive/Slides scope never touches that one.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=""
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=""
# NOTE: the webhook secret the Google Apps Script sends is no longer a
# single global env var — each event auto-generates its own, shown as
# "Webhook secret" on that event's admin edit page. Copy that value into
# the WEBHOOK_SECRET script property in the Apps Script bound to that
# event's response Sheet.

# --- File storage (Phase 2/5, add later) ---
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""

# --- Analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# --- SEO (canonical URL used in metadata, sitemap.xml, robots.txt) ---
NEXT_PUBLIC_SITE_URL="https://scholaraura.com"

# --- Cron (Vercel Cron -> /api/cron/send-reminders, see vercel.json) ---
# Any random string. When set, Vercel automatically sends it as
# `Authorization: Bearer <value>` on scheduled cron requests — the route
# checks that header and rejects anything else.
CRON_SECRET=""

# --- Sentry (error tracking/alerting) ---
# DSN from your Sentry project's Settings -> Client Keys (DSN). Not a
# secret — safe to expose to the browser, hence the NEXT_PUBLIC_ prefix.
# Leave blank to disable error reporting (e.g. local dev).
NEXT_PUBLIC_SENTRY_DSN=""

# --- Cloudflare Turnstile (bot verification on signup) ---
# Get a site key + secret key from https://dash.cloudflare.com/?to=/:account/turnstile
# Leave both blank to disable verification (e.g. local dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
