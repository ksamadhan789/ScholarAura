// ==========================================================
// Prisma Schema — E-Learning + Events Platform (v1)
// Database: PostgreSQL
// Feed this directly to Codex during Phase 1 (Auth) and
// Phase 2/4 (Courses/Events) — extend incrementally per phase.
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------
// ENUMS
// ----------------------

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum EventType {
  INTERNATIONAL_CONFERENCE
  NATIONAL_CONFERENCE
  FDP
  HANDS_ON_TRAINING
  WEBINAR
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ATTENDED
}

enum CreditTransactionType {
  EARNED
  REDEEMED
}

// ----------------------
// AUTH / USERS (Phase 1)
// ----------------------

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  passwordHash   String?
  googleId       String?   @unique
  role           Role      @default(STUDENT)
  phone          String?
  organization   String?
  firstName      String?
  middleName     String?
  lastName       String?
  userType       String?
  fieldOfStudy   String?
  jobRole        String?
  expertise      String?
  onboardingCompletedAt DateTime?
  emailVerified  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  referralCode        String?  @unique
  referredById        String?
  referredBy          User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals           User[]   @relation("Referrals")
  creditBalance       Decimal  @default(0) @db.Decimal(10, 2)
  isAffiliate         Boolean  @default(false)
  affiliateRatePercent Int?

  coursesOwned      Course[]            @relation("InstructorCourses")
  coursePurchases   CoursePurchase[]
  courseProgress    CourseProgress[]
  eventRegistrations EventRegistration[]
  certificates      Certificate[]
  creditTransactions CreditTransaction[]
  passwordResetTokens PasswordResetToken[]
  competitionEntries CompetitionEntry[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

model CreditTransaction {
  id          String                @id @default(uuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id])
  amount      Decimal               @db.Decimal(10, 2)
  type        CreditTransactionType
  description String
  createdAt   DateTime              @default(now())

  @@map("credit_transactions")
}

// ----------------------
// COURSES (Phase 2)
// ----------------------

model Course {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  description   String
  price         Decimal  @db.Decimal(10, 2)
  thumbnailUrl  String?
  category      String
  isPublished   Boolean  @default(false)
  certificateLogoUrl String?
  instructorId  String
  instructor    User     @relation("InstructorCourses", fields: [instructorId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  videos        CourseVideo[]
  purchases     CoursePurchase[]
  certificates  Certificate[]

  @@map("courses")
}

model CourseVideo {
  id                String   @id @default(uuid())
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title             String
  videoProviderId   String   // Bunny.net GUID / CloudFront key / Cloudinary public_id — NEVER a raw public URL
  durationSeconds   Int
  orderIndex        Int
  isPreview         Boolean  @default(false) // free preview clip, if any

  progress          CourseProgress[]

  @@map("course_videos")
}

model CoursePurchase {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  courseId         String
  course           Course        @relation(fields: [courseId], references: [id])
  razorpayOrderId  String?
  razorpayPaymentId String?
  amount           Decimal       @db.Decimal(10, 2)
  creditApplied    Decimal       @default(0) @db.Decimal(10, 2)
  currency         String        @default("INR")
  chargedAmount    Decimal?      @db.Decimal(10, 2)
  status           PaymentStatus @default(PENDING)
  purchasedAt      DateTime      @default(now())

  @@unique([userId, courseId])
  @@map("course_purchases")
}

model CourseProgress {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  courseVideoId  String
  courseVideo    CourseVideo @relation(fields: [courseVideoId], references: [id])
  watchedPercent Int         @default(0)
  completedAt    DateTime?
  updatedAt      DateTime    @updatedAt

  @@unique([userId, courseVideoId])
  @@map("course_progress")
}

// ----------------------
// EVENTS (Phase 4)
// ----------------------

model Event {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  type          EventType
  description   String
  startDate     DateTime
  endDate       DateTime
  fee           Decimal   @db.Decimal(10, 2) @default(0)
  seatsTotal    Int
  seatsFilled   Int       @default(0)
  venueOrLink   String
  isOnline      Boolean   @default(false)
  isPublished   Boolean   @default(false)
  thumbnailUrl  String?
  brochureUrl   String?
  shortDescription      String?
  eligibility            String?
  registrationStartDate  DateTime?
  registrationDeadline   DateTime?
  resultDate             DateTime?
  prizeDescription       String?
  prizeFirst             String?
  prizeSecond            String?
  prizeThird             String?
  certificateLogoUrl     String?
  people                 Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  registrations EventRegistration[]
  certificates  Certificate[]

  @@map("events")
}

model EventRegistration {
  id                String              @id @default(uuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id])
  eventId           String
  event             Event               @relation(fields: [eventId], references: [id])
  razorpayOrderId   String?
  razorpayPaymentId String?
  amount            Decimal             @db.Decimal(10, 2) @default(0)
  creditApplied     Decimal             @default(0) @db.Decimal(10, 2)
  currency          String              @default("INR")
  chargedAmount     Decimal?            @db.Decimal(10, 2)
  status            RegistrationStatus  @default(PENDING)
  certificateName   String?
  registeredAt      DateTime            @default(now())

  @@unique([userId, eventId])
  @@map("event_registrations")
}

// ----------------------
// COMPETITIONS (Phase 7)
// ----------------------

model Competition {
  id                 String   @id @default(uuid())
  title              String
  slug               String   @unique
  description        String
  startDate          DateTime
  endDate            DateTime
  submissionDeadline DateTime
  fee                Decimal  @db.Decimal(10, 2) @default(0)
  prizeDescription   String?
  prizeFirst         String?
  prizeSecond        String?
  prizeThird         String?
  maxTeamSize        Int      @default(1)
  isPublished        Boolean  @default(false)
  thumbnailUrl            String?
  brochureUrl             String?
  certificateLogoUrl      String?
  shortDescription       String?
  eligibility             String?
  registrationStartDate   DateTime?
  registrationDeadline    DateTime?
  resultDate              DateTime?
  people                  Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  entries            CompetitionEntry[]

  @@map("competitions")
}

model CompetitionEntry {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  competitionId     String
  competition       Competition   @relation(fields: [competitionId], references: [id])
  teamName          String?
  teammates         String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  amount            Decimal       @default(0) @db.Decimal(10, 2)
  creditApplied     Decimal       @default(0) @db.Decimal(10, 2)
  currency          String        @default("INR")
  chargedAmount     Decimal?      @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  submissionUrl     String?
  submissionNotes   String?
  submittedAt       DateTime?
  rank              Int?
  registeredAt      DateTime      @default(now())

  @@unique([userId, competitionId])
  @@map("competition_entries")
}

// ----------------------
// CERTIFICATES (Phase 4/5)
// ----------------------

model Certificate {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  courseId         String?
  course           Course?  @relation(fields: [courseId], references: [id])
  eventId          String?
  event            Event?   @relation(fields: [eventId], references: [id])
  certificateNumber String  @unique // e.g., CERT-2026-000123, used for public verification
  pdfUrl           String
  issuedAt         DateTime @default(now())

  @@unique([userId, courseId])
  @@unique([userId, eventId])
  @@map("certificates")
}

// ----------------------
// CURRENCY (Phase 6)
// ----------------------

model ExchangeRate {
  id           String   @id @default(uuid())
  currencyCode String   @unique // e.g. "USD", "EUR", "GBP"
  symbol       String // e.g. "$", "€", "£"
  rateFromInr  Decimal  @db.Decimal(12, 6) // units of this currency per 1 INR
  updatedAt    DateTime @updatedAt

  @@map("exchange_rates")
}

// ----------------------
// EXTERNAL / RECOMMENDED COURSES (Phase 7)
// Curated links to third-party courses (Google, Coursera, edX, etc.) —
// we do NOT host their content or issue their certificates, just link out.
// ----------------------

model ExternalCourse {
  id          String   @id @default(uuid())
  title       String
  provider    String // e.g. "Google", "Coursera", "edX"
  description String
  url         String // external link — opens in a new tab
  category    String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("external_courses")
}
