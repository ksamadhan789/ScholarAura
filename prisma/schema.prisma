// ==========================================================
// Prisma Schema — E-Learning + Events Platform (v1)
// Database: PostgreSQL
// Feed this directly to Codex during Phase 1 (Auth) and
// Phase 2/4 (Courses/Events) — extend incrementally per phase.
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------
// ENUMS
// ----------------------

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
  RECRUITER
}

enum EventType {
  INTERNATIONAL_CONFERENCE
  NATIONAL_CONFERENCE
  FDP
  HANDS_ON_TRAINING
  WEBINAR
}

enum EventFormat {
  ONLINE
  OFFLINE
  HYBRID
}

enum EventAudience {
  STUDENT
  PROFESSIONAL
  EVERYONE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ATTENDED
  REFUNDED
}

enum CreditTransactionType {
  EARNED
  REDEEMED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum CouponScope {
  ALL
  COURSE
  EVENT
  COMPETITION
}

enum CollegeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CertificateStatus {
  NOT_ELIGIBLE
  ELIGIBLE
  PROCESSING
  GENERATED
  AVAILABLE
  REVOKED
  FAILED
}

// ----------------------
// AUTH / USERS (Phase 1)
// ----------------------

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  passwordHash   String?
  googleId       String?   @unique
  role           Role      @default(STUDENT)
  phone          String?
  organization   String?
  firstName      String?
  middleName     String?
  lastName       String?
  userType       String?
  fieldOfStudy   String?
  jobRole        String?
  expertise      String?
  onboardingCompletedAt DateTime?
  consentAcceptedAt DateTime?
  marketingOptIn Boolean   @default(false)
  emailVerified  Boolean   @default(false)
  publicProfileEnabled Boolean @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  referralCode        String?  @unique
  referredById        String?
  referredBy          User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals           User[]   @relation("Referrals")
  creditBalance       Decimal  @default(0) @db.Decimal(10, 2)
  isAffiliate         Boolean  @default(false)
  affiliateRatePercent Int?
  instructorCommissionRatePercent Int?

  coursesOwned      Course[]            @relation("InstructorCourses")
  coursePurchases   CoursePurchase[]
  courseProgress    CourseProgress[]
  eventRegistrations EventRegistration[]
  certificates      Certificate[]
  creditTransactions CreditTransaction[]
  passwordResetTokens PasswordResetToken[]
  competitionEntries CompetitionEntry[]
  eventWaitlistEntries EventWaitlist[]
  postedJobs        Job[]               @relation("PostedJobs")
  jobApplications   JobApplication[]
  recruiterProfile  RecruiterProfile?
  courseReviews     CourseReview[]
  courseWishlist    CourseWishlist[]
  courseQuestions   CourseQuestion[]
  courseAnswers     CourseAnswer[]
  notifications     Notification[]
  refundRequests    RefundRequest[]
  auditLogs         AuditLog[]
  quizAttempts      QuizAttempt[]
  bundlePurchases   BundlePurchase[]
  eventWishlist       EventWishlist[]
  competitionWishlist CompetitionWishlist[]
  jobWishlist         JobWishlist[]

  @@map("users")
}

model College {
  id           String        @id @default(uuid())
  name         String        @unique
  city         String?
  state        String?
  university   String?
  collegeType  String?
  status       CollegeStatus @default(APPROVED)
  createdAt    DateTime      @default(now())

  @@map("colleges")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

model CreditTransaction {
  id          String                @id @default(uuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id])
  amount      Decimal               @db.Decimal(10, 2)
  type        CreditTransactionType
  description String
  createdAt   DateTime              @default(now())

  @@map("credit_transactions")
}

model Coupon {
  id              String       @id @default(uuid())
  code            String       @unique
  discountType    DiscountType
  discountValue   Decimal      @db.Decimal(10, 2)
  appliesTo       CouponScope  @default(ALL)
  maxRedemptions  Int?
  redemptionCount Int          @default(0)
  minAmount       Decimal?     @db.Decimal(10, 2)
  expiresAt       DateTime?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  coursePurchases    CoursePurchase[]
  eventRegistrations EventRegistration[]
  competitionEntries CompetitionEntry[]

  @@map("coupons")
}

// ----------------------
// COURSES (Phase 2)
// ----------------------

model Course {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  description   String
  price         Decimal  @db.Decimal(10, 2)
  thumbnailUrl  String?
  category      String
  isPublished   Boolean  @default(false)
  certificateLogoUrl String?
  instructorId  String
  instructor    User     @relation("InstructorCourses", fields: [instructorId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  videos        CourseVideo[]
  purchases     CoursePurchase[]
  certificates  Certificate[]
  reviews       CourseReview[]
  wishlistedBy  CourseWishlist[]
  questions     CourseQuestion[]
  quizzes       Quiz[]
  resources     CourseResource[]
  bundleItems   CourseBundleItem[]

  @@map("courses")
}

// A quiz belongs to a course, and optionally to one specific lecture within
// it — courseVideoId null means it's the course's final quiz. questions is
// a QuizQuestion[] (see lib/quiz.ts) rather than normalized tables: nothing
// here needs cross-quiz querying or reuse of individual questions, so the
// relational overhead of separate question/option tables buys nothing over
// a validated JSON blob (the same tradeoff Event.people already makes).
model Quiz {
  id             String       @id @default(uuid())
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseVideoId  String?      @unique
  courseVideo    CourseVideo? @relation(fields: [courseVideoId], references: [id], onDelete: Cascade)
  title          String
  passingPercent Int          @default(70)
  questions      Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  attempts QuizAttempt[]

  @@index([courseId])
  @@map("quizzes")
}

model QuizAttempt {
  id           String   @id @default(uuid())
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  scorePercent Int
  passed       Boolean
  answers      Json
  submittedAt  DateTime @default(now())

  @@index([quizId, userId])
  @@map("quiz_attempts")
}

// A downloadable file attached to a course, and optionally to one specific
// lecture within it — courseVideoId null means it's a course-wide resource.
// Unlike Quiz, a lecture or course can have any number of these, so there's
// no unique constraint on courseVideoId here. The file itself lives in
// Google Drive (see lib/courseResourceStorage.ts); only its Drive file ID
// is stored here, matching the JobApplication.resumeFileId pattern.
model CourseResource {
  id            String       @id @default(uuid())
  courseId      String
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseVideoId String?
  courseVideo   CourseVideo? @relation(fields: [courseVideoId], references: [id], onDelete: Cascade)
  title         String
  fileId        String
  fileName      String
  mimeType      String
  fileSizeBytes Int
  createdAt     DateTime     @default(now())

  @@index([courseId])
  @@index([courseVideoId])
  @@map("course_resources")
}

model CourseWishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("course_wishlist")
}

model EventWishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("event_wishlist")
}

model CompetitionWishlist {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([userId, competitionId])
  @@index([competitionId])
  @@map("competition_wishlist")
}

model JobWishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([jobId])
  @@map("job_wishlist")
}

model CourseVideo {
  id                String   @id @default(uuid())
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title             String
  videoProviderId   String   // Bunny.net GUID / CloudFront key / Cloudinary public_id — NEVER a raw public URL
  durationSeconds   Int
  orderIndex        Int
  isPreview         Boolean  @default(false) // free preview clip, if any

  progress          CourseProgress[]
  quiz              Quiz?
  resources         CourseResource[]

  @@map("course_videos")
}

model CoursePurchase {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  courseId         String
  course           Course        @relation(fields: [courseId], references: [id])
  razorpayOrderId  String?
  razorpayPaymentId String?
  amount           Decimal       @db.Decimal(10, 2)
  creditApplied    Decimal       @default(0) @db.Decimal(10, 2)
  currency         String        @default("INR")
  chargedAmount    Decimal?      @db.Decimal(10, 2)
  status           PaymentStatus @default(PENDING)
  couponId         String?
  coupon           Coupon?       @relation(fields: [couponId], references: [id])
  discountAmount   Decimal       @default(0) @db.Decimal(10, 2)
  purchasedAt      DateTime      @default(now())

  refundRequests   RefundRequest[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("course_purchases")
}

// A curated, ordered set of existing courses sold at one price — also
// functions as a learning path: its page shows completion across every
// included course, not just a one-time bundle discount. Admin-managed only
// (see BundlePurchase below), since a bundle can cross instructors and is
// an editorial/catalog decision rather than something an instructor owns.
model CourseBundle {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  description  String
  price        Decimal  @db.Decimal(10, 2)
  thumbnailUrl String?
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items     CourseBundleItem[]
  purchases BundlePurchase[]

  @@map("course_bundles")
}

model CourseBundleItem {
  id         String       @id @default(uuid())
  bundleId   String
  bundle     CourseBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orderIndex Int

  @@unique([bundleId, courseId])
  @@index([courseId])
  @@map("course_bundle_items")
}

// Records the bundle-level payment. The courses it grants access to are
// fanned out into ordinary CoursePurchase rows (see lib/bundlePurchase.ts)
// rather than tracked here, so every existing access check — enrollment,
// certificates, quizzes, downloadable resources — needs no bundle-awareness
// at all. Coupons and credit-balance application are intentionally not
// supported on bundle checkouts (v1 scope).
model BundlePurchase {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  bundleId          String
  bundle            CourseBundle  @relation(fields: [bundleId], references: [id])
  razorpayOrderId   String?
  razorpayPaymentId String?
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  chargedAmount     Decimal?      @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  purchasedAt       DateTime      @default(now())

  @@unique([userId, bundleId])
  @@map("bundle_purchases")
}

model CourseProgress {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  courseVideoId  String
  courseVideo    CourseVideo @relation(fields: [courseVideoId], references: [id])
  watchedPercent Int         @default(0)
  // Set once, when the lecture page first pings the start endpoint — never
  // touched again, so it's a stable anchor for "how long has this student
  // actually had the lecture open" rather than something a completion
  // request can move by resubmitting.
  startedAt      DateTime?
  completedAt    DateTime?
  updatedAt      DateTime    @updatedAt

  @@unique([userId, courseVideoId])
  @@map("course_progress")
}

// ----------------------
// EVENTS (Phase 4)
// ----------------------

model Event {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  type          EventType
  description   String
  startDate     DateTime
  endDate       DateTime
  fee           Decimal   @db.Decimal(10, 2) @default(0)
  seatsTotal    Int
  seatsFilled   Int       @default(0)
  venueOrLink   String
  format        EventFormat @default(OFFLINE)
  city          String?
  audience      EventAudience @default(EVERYONE)
  isPublished   Boolean   @default(false)
  isArchived    Boolean   @default(false)
  thumbnailUrl  String?
  brochureUrl   String?
  shortDescription      String?
  eligibility            String?
  registrationStartDate  DateTime?
  registrationDeadline   DateTime?
  resultDate             DateTime?
  prizeDescription       String?
  prizeFirst             String?
  prizeSecond            String?
  prizeThird             String?
  certificateLogoUrl     String?
  people                 Json?
  organizer                  String?
  googleFormUrl               String?
  googleFormNameEntryId       String?
  googleFormEmailEntryId      String?
  googleFormEnrollmentEntryId String?
  googleSheetId               String?
  webhookSecret               String   @unique @default(uuid())
  attendanceRequired          Boolean  @default(false)
  minAttendancePercent        Int?
  certificateEnabled          Boolean  @default(true)
  certificateType              String?  @default("PARTICIPATION")
  googleSlidesTemplateId       String?
  certificateSignatoryName     String?
  certificateSignatoryTitle    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  registrations EventRegistration[]
  certificates  Certificate[]
  waitlist      EventWaitlist[]
  wishlistedBy  EventWishlist[]

  @@map("events")
}

model EventWaitlist {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id])
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, eventId])
  @@map("event_waitlist")
}

model EventRegistration {
  id                String              @id @default(uuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id])
  eventId           String
  event             Event               @relation(fields: [eventId], references: [id])
  razorpayOrderId   String?
  razorpayPaymentId String?
  amount            Decimal             @db.Decimal(10, 2) @default(0)
  creditApplied     Decimal             @default(0) @db.Decimal(10, 2)
  currency          String              @default("INR")
  chargedAmount     Decimal?            @db.Decimal(10, 2)
  status            RegistrationStatus  @default(PENDING)
  couponId          String?
  coupon            Coupon?             @relation(fields: [couponId], references: [id])
  discountAmount    Decimal             @default(0) @db.Decimal(10, 2)
  certificateName   String?
  enrollmentNumber       String?   @unique
  formSubmitted          Boolean   @default(false)
  formSubmissionDate     DateTime?
  googleResponseId       String?   @unique
  attendancePercent      Int?
  attendanceVerifiedAt   DateTime?
  eligibleForCertificate Boolean   @default(false)
  reminderSentAt         DateTime?
  registeredAt      DateTime            @default(now())

  refundRequests    RefundRequest[]

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("event_registrations")
}

// ----------------------
// COMPETITIONS (Phase 7)
// ----------------------

model Competition {
  id                 String   @id @default(uuid())
  title              String
  slug               String   @unique
  description        String
  startDate          DateTime
  endDate            DateTime
  submissionDeadline DateTime
  fee                Decimal  @db.Decimal(10, 2) @default(0)
  prizeDescription   String?
  prizeFirst         String?
  prizeSecond        String?
  prizeThird         String?
  maxTeamSize        Int      @default(1)
  isPublished        Boolean  @default(false)
  isArchived         Boolean  @default(false)
  thumbnailUrl            String?
  brochureUrl             String?
  certificateLogoUrl      String?
  shortDescription       String?
  eligibility             String?
  registrationStartDate   DateTime?
  registrationDeadline    DateTime?
  resultDate              DateTime?
  people                  Json?
  organizer                   String?
  googleFormUrl                String?
  googleFormNameEntryId        String?
  googleFormEmailEntryId       String?
  googleFormEnrollmentEntryId  String?
  googleSheetId                String?
  webhookSecret                String   @unique @default(uuid())
  attendanceRequired           Boolean  @default(false)
  minAttendancePercent         Int?
  certificateEnabled           Boolean  @default(true)
  certificateType               String?  @default("PARTICIPATION")
  googleSlidesTemplateId        String?
  certificateSignatoryName      String?
  certificateSignatoryTitle     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  entries            CompetitionEntry[]
  certificates        Certificate[]
  wishlistedBy        CompetitionWishlist[]

  @@map("competitions")
}

model CompetitionEntry {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  competitionId     String
  competition       Competition   @relation(fields: [competitionId], references: [id])
  teamName          String?
  teammates         String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  amount            Decimal       @default(0) @db.Decimal(10, 2)
  creditApplied     Decimal       @default(0) @db.Decimal(10, 2)
  currency          String        @default("INR")
  chargedAmount     Decimal?      @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  couponId          String?
  coupon            Coupon?       @relation(fields: [couponId], references: [id])
  discountAmount    Decimal       @default(0) @db.Decimal(10, 2)
  submissionUrl     String?
  submissionNotes   String?
  submittedAt       DateTime?
  rank              Int?
  certificateName        String?
  enrollmentNumber       String?   @unique
  formSubmitted          Boolean   @default(false)
  formSubmissionDate     DateTime?
  googleResponseId       String?   @unique
  attendancePercent      Int?
  attendanceVerifiedAt   DateTime?
  eligibleForCertificate Boolean   @default(false)
  reminderSentAt         DateTime?
  registeredAt      DateTime      @default(now())

  refundRequests    RefundRequest[]

  @@unique([userId, competitionId])
  @@index([competitionId])
  @@map("competition_entries")
}

// ----------------------
// CERTIFICATES (Phase 4/5)
// ----------------------

model Certificate {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  courseId         String?
  course           Course?  @relation(fields: [courseId], references: [id])
  eventId          String?
  event            Event?   @relation(fields: [eventId], references: [id])
  competitionId    String?
  competition      Competition? @relation(fields: [competitionId], references: [id])
  certificateNumber String  @unique // e.g., CERT-2026-000123, used for public verification
  pdfUrl           String
  issuedAt         DateTime @default(now())
  status               CertificateStatus @default(GENERATED)
  certificateType      String?
  attendancePercentage Int?
  googleSlideFileId    String?
  googleDriveFileId    String?
  errorMessage         String?
  retryCount           Int               @default(0)
  lastAttemptAt        DateTime?
  revokedAt            DateTime?
  revokedReason        String?

  @@unique([userId, courseId])
  @@unique([userId, eventId])
  @@unique([userId, competitionId])
  @@index([courseId])
  @@index([eventId])
  @@index([competitionId])
  @@map("certificates")
}

// Singleton row (fixed id "drive-connection") holding the OAuth refresh
// token for the personal Google account certificate generation runs as.
// Needed because a bare service account has zero Drive storage quota on a
// non-Workspace account — files it creates/copies can't actually be saved.
// Delegating to a real connected account's own storage sidesteps that.
model GoogleDriveConnection {
  id           String   @id
  googleEmail  String
  refreshToken String
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("google_drive_connections")
}

// ----------------------
// CURRENCY (Phase 6)
// ----------------------

model ExchangeRate {
  id           String   @id @default(uuid())
  currencyCode String   @unique // e.g. "USD", "EUR", "GBP"
  symbol       String // e.g. "$", "€", "£"
  rateFromInr  Decimal  @db.Decimal(12, 6) // units of this currency per 1 INR
  updatedAt    DateTime @updatedAt

  @@map("exchange_rates")
}

// ----------------------
// EXTERNAL / RECOMMENDED COURSES (Phase 7)
// Curated links to third-party courses (Google, Coursera, edX, etc.) —
// we do NOT host their content or issue their certificates, just link out.
// ----------------------

model ExternalCourse {
  id          String   @id @default(uuid())
  title       String
  provider    String // e.g. "Google", "Coursera", "edX"
  description String
  url         String // external link — opens in a new tab
  category    String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("external_courses")
}

// ----------------------
// RATE LIMITING
// One row per limited key (e.g. "login:user@example.com", "checkout:{userId}")
// — the table stays bounded by the number of distinct keys ever seen, not by
// request volume, since each new window overwrites the same row rather than
// inserting a new one.
// ----------------------

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(1)

  @@map("rate_limit_buckets")
}

// ----------------------
// JOBS
// Phase 1: ScholarAura's own team posts jobs directly (isPublished toggle,
// same pattern as courses/events/competitions). A recruiter self-serve tab
// with its own account type and an admin approval queue for their postings
// is a planned follow-up — postedByUserId/approvalStatus are already shaped
// to support that without a schema change later.
// ----------------------

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum JobApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Job {
  id                  String             @id @default(uuid())
  slug                String             @unique
  title               String
  companyName         String
  companyLogoUrl      String?
  location            String
  isRemote            Boolean            @default(false)
  employmentType      EmploymentType
  description         String
  requirements        String?
  minExperienceYears  Int?
  salaryRange         String?
  applicationDeadline DateTime?
  isPublished         Boolean            @default(false)
  approvalStatus      JobApprovalStatus  @default(APPROVED)
  rejectionReason     String?
  postedByUserId      String
  postedByUser        User               @relation("PostedJobs", fields: [postedByUserId], references: [id])
  recruiterProfileId  String?
  recruiterProfile    RecruiterProfile?  @relation(fields: [recruiterProfileId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  applications        JobApplication[]
  wishlistedBy        JobWishlist[]

  @@map("jobs")
}

// ----------------------
// RECRUITERS (Phase 2)
// A separate, verified account type. Signing up only creates a PENDING
// profile — admin approval is required before a recruiter can submit a
// job, and every job they submit still goes through its own approval
// (approvalStatus on Job) even after their account is approved.
// ----------------------

enum RecruiterStatus {
  PENDING
  APPROVED
  REJECTED
}

model RecruiterProfile {
  id              String          @id @default(uuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id])
  companyName     String
  companyWebsite  String?
  designation     String?
  status          RecruiterStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  jobs            Job[]

  @@map("recruiter_profiles")
}

enum JobApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  HIRED
}

model JobApplication {
  id           String               @id @default(uuid())
  jobId        String
  job          Job                  @relation(fields: [jobId], references: [id])
  userId       String
  user         User                 @relation(fields: [userId], references: [id])
  resumeFileId String
  resumeName   String
  coverNote    String?
  status       JobApplicationStatus @default(APPLIED)
  appliedAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([jobId, userId])
  @@index([userId])
  @@map("job_applications")
}

// ----------------------
// COURSE REVIEWS
// One review per verified enrollment (a CoursePurchase with status SUCCESS)
// — checked at write time, not enforced by a DB constraint, since a
// purchase could in principle be refunded after a review is left.
// ----------------------

model CourseReview {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, userId])
  @@map("course_reviews")
}

// ----------------------
// COURSE Q&A
// Any enrolled student can ask; any enrolled student, the course's
// instructor, or an admin can answer. Enrollment is checked at write time,
// same tradeoff as CourseReview above.
// ----------------------

model CourseQuestion {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers   CourseAnswer[]

  @@map("course_questions")
}

model CourseAnswer {
  id         String         @id @default(uuid())
  questionId String
  question   CourseQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  body       String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("course_answers")
}

// ----------------------
// IN-APP NOTIFICATIONS
// A lightweight, generic notification row created alongside (not instead
// of) the existing transactional emails for the same event, so a user
// still sees it even if they never open their inbox.
// ----------------------

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  url       String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

// ----------------------
// SELF-SERVE REFUND REQUESTS
// Exactly one of coursePurchaseId/eventRegistrationId/competitionEntryId is
// set, same polymorphic-FK shape as Certificate above. Approving a request
// calls the existing admin refund* functions in lib/refund.ts — this model
// only tracks the request/review step in front of them.
// ----------------------

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model RefundRequest {
  id                  String              @id @default(uuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id])
  coursePurchaseId    String?
  coursePurchase      CoursePurchase?     @relation(fields: [coursePurchaseId], references: [id])
  eventRegistrationId String?
  eventRegistration   EventRegistration?  @relation(fields: [eventRegistrationId], references: [id])
  competitionEntryId  String?
  competitionEntry    CompetitionEntry?   @relation(fields: [competitionEntryId], references: [id])
  reason              String
  status              RefundRequestStatus @default(PENDING)
  rejectionReason     String?
  createdAt           DateTime            @default(now())
  resolvedAt          DateTime?

  @@map("refund_requests")
}
