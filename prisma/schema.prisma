// ==========================================================
// Prisma Schema — E-Learning + Events Platform (v1)
// Database: PostgreSQL
// Feed this directly to Codex during Phase 1 (Auth) and
// Phase 2/4 (Courses/Events) — extend incrementally per phase.
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------
// ENUMS
// ----------------------

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
  RECRUITER
}

enum EventType {
  INTERNATIONAL_CONFERENCE
  NATIONAL_CONFERENCE
  FDP
  HANDS_ON_TRAINING
  WEBINAR
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ATTENDED
  REFUNDED
}

enum CreditTransactionType {
  EARNED
  REDEEMED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum CouponScope {
  ALL
  COURSE
  EVENT
  COMPETITION
}

enum CollegeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CertificateStatus {
  NOT_ELIGIBLE
  ELIGIBLE
  PROCESSING
  GENERATED
  AVAILABLE
  REVOKED
  FAILED
}

// ----------------------
// AUTH / USERS (Phase 1)
// ----------------------

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  passwordHash   String?
  googleId       String?   @unique
  role           Role      @default(STUDENT)
  phone          String?
  organization   String?
  firstName      String?
  middleName     String?
  lastName       String?
  userType       String?
  fieldOfStudy   String?
  jobRole        String?
  expertise      String?
  onboardingCompletedAt DateTime?
  consentAcceptedAt DateTime?
  marketingOptIn Boolean   @default(false)
  emailVerified  Boolean   @default(false)
  publicProfileEnabled Boolean @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  referralCode        String?  @unique
  referredById        String?
  referredBy          User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals           User[]   @relation("Referrals")
  creditBalance       Decimal  @default(0) @db.Decimal(10, 2)
  isAffiliate         Boolean  @default(false)
  affiliateRatePercent Int?

  coursesOwned      Course[]            @relation("InstructorCourses")
  coursePurchases   CoursePurchase[]
  courseProgress    CourseProgress[]
  eventRegistrations EventRegistration[]
  certificates      Certificate[]
  creditTransactions CreditTransaction[]
  passwordResetTokens PasswordResetToken[]
  competitionEntries CompetitionEntry[]
  eventWaitlistEntries EventWaitlist[]
  postedJobs        Job[]               @relation("PostedJobs")
  jobApplications   JobApplication[]
  recruiterProfile  RecruiterProfile?
  courseReviews     CourseReview[]

  @@map("users")
}

model College {
  id           String        @id @default(uuid())
  name         String        @unique
  city         String?
  state        String?
  university   String?
  collegeType  String?
  status       CollegeStatus @default(APPROVED)
  createdAt    DateTime      @default(now())

  @@map("colleges")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

model CreditTransaction {
  id          String                @id @default(uuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id])
  amount      Decimal               @db.Decimal(10, 2)
  type        CreditTransactionType
  description String
  createdAt   DateTime              @default(now())

  @@map("credit_transactions")
}

model Coupon {
  id              String       @id @default(uuid())
  code            String       @unique
  discountType    DiscountType
  discountValue   Decimal      @db.Decimal(10, 2)
  appliesTo       CouponScope  @default(ALL)
  maxRedemptions  Int?
  redemptionCount Int          @default(0)
  minAmount       Decimal?     @db.Decimal(10, 2)
  expiresAt       DateTime?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  coursePurchases    CoursePurchase[]
  eventRegistrations EventRegistration[]
  competitionEntries CompetitionEntry[]

  @@map("coupons")
}

// ----------------------
// COURSES (Phase 2)
// ----------------------

model Course {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  description   String
  price         Decimal  @db.Decimal(10, 2)
  thumbnailUrl  String?
  category      String
  isPublished   Boolean  @default(false)
  certificateLogoUrl String?
  instructorId  String
  instructor    User     @relation("InstructorCourses", fields: [instructorId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  videos        CourseVideo[]
  purchases     CoursePurchase[]
  certificates  Certificate[]
  reviews       CourseReview[]

  @@map("courses")
}

model CourseVideo {
  id                String   @id @default(uuid())
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title             String
  videoProviderId   String   // Bunny.net GUID / CloudFront key / Cloudinary public_id — NEVER a raw public URL
  durationSeconds   Int
  orderIndex        Int
  isPreview         Boolean  @default(false) // free preview clip, if any

  progress          CourseProgress[]

  @@map("course_videos")
}

model CoursePurchase {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  courseId         String
  course           Course        @relation(fields: [courseId], references: [id])
  razorpayOrderId  String?
  razorpayPaymentId String?
  amount           Decimal       @db.Decimal(10, 2)
  creditApplied    Decimal       @default(0) @db.Decimal(10, 2)
  currency         String        @default("INR")
  chargedAmount    Decimal?      @db.Decimal(10, 2)
  status           PaymentStatus @default(PENDING)
  couponId         String?
  coupon           Coupon?       @relation(fields: [couponId], references: [id])
  discountAmount   Decimal       @default(0) @db.Decimal(10, 2)
  purchasedAt      DateTime      @default(now())

  @@unique([userId, courseId])
  @@map("course_purchases")
}

model CourseProgress {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  courseVideoId  String
  courseVideo    CourseVideo @relation(fields: [courseVideoId], references: [id])
  watchedPercent Int         @default(0)
  completedAt    DateTime?
  updatedAt      DateTime    @updatedAt

  @@unique([userId, courseVideoId])
  @@map("course_progress")
}

// ----------------------
// EVENTS (Phase 4)
// ----------------------

model Event {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  type          EventType
  description   String
  startDate     DateTime
  endDate       DateTime
  fee           Decimal   @db.Decimal(10, 2) @default(0)
  seatsTotal    Int
  seatsFilled   Int       @default(0)
  venueOrLink   String
  isOnline      Boolean   @default(false)
  isPublished   Boolean   @default(false)
  isArchived    Boolean   @default(false)
  thumbnailUrl  String?
  brochureUrl   String?
  shortDescription      String?
  eligibility            String?
  registrationStartDate  DateTime?
  registrationDeadline   DateTime?
  resultDate             DateTime?
  prizeDescription       String?
  prizeFirst             String?
  prizeSecond            String?
  prizeThird             String?
  certificateLogoUrl     String?
  people                 Json?
  organizer                  String?
  googleFormUrl               String?
  googleFormNameEntryId       String?
  googleFormEmailEntryId      String?
  googleFormEnrollmentEntryId String?
  googleSheetId               String?
  webhookSecret               String   @unique @default(uuid())
  attendanceRequired          Boolean  @default(false)
  minAttendancePercent        Int?
  certificateEnabled          Boolean  @default(true)
  certificateType              String?  @default("PARTICIPATION")
  googleSlidesTemplateId       String?
  certificateSignatoryName     String?
  certificateSignatoryTitle    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  registrations EventRegistration[]
  certificates  Certificate[]
  waitlist      EventWaitlist[]

  @@map("events")
}

model EventWaitlist {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id])
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, eventId])
  @@map("event_waitlist")
}

model EventRegistration {
  id                String              @id @default(uuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id])
  eventId           String
  event             Event               @relation(fields: [eventId], references: [id])
  razorpayOrderId   String?
  razorpayPaymentId String?
  amount            Decimal             @db.Decimal(10, 2) @default(0)
  creditApplied     Decimal             @default(0) @db.Decimal(10, 2)
  currency          String              @default("INR")
  chargedAmount     Decimal?            @db.Decimal(10, 2)
  status            RegistrationStatus  @default(PENDING)
  couponId          String?
  coupon            Coupon?             @relation(fields: [couponId], references: [id])
  discountAmount    Decimal             @default(0) @db.Decimal(10, 2)
  certificateName   String?
  enrollmentNumber       String?   @unique
  formSubmitted          Boolean   @default(false)
  formSubmissionDate     DateTime?
  googleResponseId       String?   @unique
  attendancePercent      Int?
  attendanceVerifiedAt   DateTime?
  eligibleForCertificate Boolean   @default(false)
  reminderSentAt         DateTime?
  registeredAt      DateTime            @default(now())

  @@unique([userId, eventId])
  @@map("event_registrations")
}

// ----------------------
// COMPETITIONS (Phase 7)
// ----------------------

model Competition {
  id                 String   @id @default(uuid())
  title              String
  slug               String   @unique
  description        String
  startDate          DateTime
  endDate            DateTime
  submissionDeadline DateTime
  fee                Decimal  @db.Decimal(10, 2) @default(0)
  prizeDescription   String?
  prizeFirst         String?
  prizeSecond        String?
  prizeThird         String?
  maxTeamSize        Int      @default(1)
  isPublished        Boolean  @default(false)
  isArchived         Boolean  @default(false)
  thumbnailUrl            String?
  brochureUrl             String?
  certificateLogoUrl      String?
  shortDescription       String?
  eligibility             String?
  registrationStartDate   DateTime?
  registrationDeadline    DateTime?
  resultDate              DateTime?
  people                  Json?
  organizer                   String?
  googleFormUrl                String?
  googleFormNameEntryId        String?
  googleFormEmailEntryId       String?
  googleFormEnrollmentEntryId  String?
  googleSheetId                String?
  webhookSecret                String   @unique @default(uuid())
  attendanceRequired           Boolean  @default(false)
  minAttendancePercent         Int?
  certificateEnabled           Boolean  @default(true)
  certificateType               String?  @default("PARTICIPATION")
  googleSlidesTemplateId        String?
  certificateSignatoryName      String?
  certificateSignatoryTitle     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  entries            CompetitionEntry[]
  certificates        Certificate[]

  @@map("competitions")
}

model CompetitionEntry {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  competitionId     String
  competition       Competition   @relation(fields: [competitionId], references: [id])
  teamName          String?
  teammates         String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  amount            Decimal       @default(0) @db.Decimal(10, 2)
  creditApplied     Decimal       @default(0) @db.Decimal(10, 2)
  currency          String        @default("INR")
  chargedAmount     Decimal?      @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  couponId          String?
  coupon            Coupon?       @relation(fields: [couponId], references: [id])
  discountAmount    Decimal       @default(0) @db.Decimal(10, 2)
  submissionUrl     String?
  submissionNotes   String?
  submittedAt       DateTime?
  rank              Int?
  certificateName        String?
  enrollmentNumber       String?   @unique
  formSubmitted          Boolean   @default(false)
  formSubmissionDate     DateTime?
  googleResponseId       String?   @unique
  attendancePercent      Int?
  attendanceVerifiedAt   DateTime?
  eligibleForCertificate Boolean   @default(false)
  reminderSentAt         DateTime?
  registeredAt      DateTime      @default(now())

  @@unique([userId, competitionId])
  @@map("competition_entries")
}

// ----------------------
// CERTIFICATES (Phase 4/5)
// ----------------------

model Certificate {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  courseId         String?
  course           Course?  @relation(fields: [courseId], references: [id])
  eventId          String?
  event            Event?   @relation(fields: [eventId], references: [id])
  competitionId    String?
  competition      Competition? @relation(fields: [competitionId], references: [id])
  certificateNumber String  @unique // e.g., CERT-2026-000123, used for public verification
  pdfUrl           String
  issuedAt         DateTime @default(now())
  status               CertificateStatus @default(GENERATED)
  certificateType      String?
  attendancePercentage Int?
  googleSlideFileId    String?
  googleDriveFileId    String?
  errorMessage         String?
  retryCount           Int               @default(0)
  lastAttemptAt        DateTime?
  revokedAt            DateTime?
  revokedReason        String?

  @@unique([userId, courseId])
  @@unique([userId, eventId])
  @@unique([userId, competitionId])
  @@map("certificates")
}

// Singleton row (fixed id "drive-connection") holding the OAuth refresh
// token for the personal Google account certificate generation runs as.
// Needed because a bare service account has zero Drive storage quota on a
// non-Workspace account — files it creates/copies can't actually be saved.
// Delegating to a real connected account's own storage sidesteps that.
model GoogleDriveConnection {
  id           String   @id
  googleEmail  String
  refreshToken String
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("google_drive_connections")
}

// ----------------------
// CURRENCY (Phase 6)
// ----------------------

model ExchangeRate {
  id           String   @id @default(uuid())
  currencyCode String   @unique // e.g. "USD", "EUR", "GBP"
  symbol       String // e.g. "$", "€", "£"
  rateFromInr  Decimal  @db.Decimal(12, 6) // units of this currency per 1 INR
  updatedAt    DateTime @updatedAt

  @@map("exchange_rates")
}

// ----------------------
// EXTERNAL / RECOMMENDED COURSES (Phase 7)
// Curated links to third-party courses (Google, Coursera, edX, etc.) —
// we do NOT host their content or issue their certificates, just link out.
// ----------------------

model ExternalCourse {
  id          String   @id @default(uuid())
  title       String
  provider    String // e.g. "Google", "Coursera", "edX"
  description String
  url         String // external link — opens in a new tab
  category    String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("external_courses")
}

// ----------------------
// RATE LIMITING
// One row per limited key (e.g. "login:user@example.com", "checkout:{userId}")
// — the table stays bounded by the number of distinct keys ever seen, not by
// request volume, since each new window overwrites the same row rather than
// inserting a new one.
// ----------------------

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(1)

  @@map("rate_limit_buckets")
}

// ----------------------
// JOBS
// Phase 1: ScholarAura's own team posts jobs directly (isPublished toggle,
// same pattern as courses/events/competitions). A recruiter self-serve tab
// with its own account type and an admin approval queue for their postings
// is a planned follow-up — postedByUserId/approvalStatus are already shaped
// to support that without a schema change later.
// ----------------------

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum JobApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Job {
  id                  String             @id @default(uuid())
  slug                String             @unique
  title               String
  companyName         String
  companyLogoUrl      String?
  location            String
  isRemote            Boolean            @default(false)
  employmentType      EmploymentType
  description         String
  requirements        String?
  minExperienceYears  Int?
  salaryRange         String?
  applicationDeadline DateTime?
  isPublished         Boolean            @default(false)
  approvalStatus      JobApprovalStatus  @default(APPROVED)
  rejectionReason     String?
  postedByUserId      String
  postedByUser        User               @relation("PostedJobs", fields: [postedByUserId], references: [id])
  recruiterProfileId  String?
  recruiterProfile    RecruiterProfile?  @relation(fields: [recruiterProfileId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  applications        JobApplication[]

  @@map("jobs")
}

// ----------------------
// RECRUITERS (Phase 2)
// A separate, verified account type. Signing up only creates a PENDING
// profile — admin approval is required before a recruiter can submit a
// job, and every job they submit still goes through its own approval
// (approvalStatus on Job) even after their account is approved.
// ----------------------

enum RecruiterStatus {
  PENDING
  APPROVED
  REJECTED
}

model RecruiterProfile {
  id              String          @id @default(uuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id])
  companyName     String
  companyWebsite  String?
  designation     String?
  status          RecruiterStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  jobs            Job[]

  @@map("recruiter_profiles")
}

enum JobApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  HIRED
}

model JobApplication {
  id           String               @id @default(uuid())
  jobId        String
  job          Job                  @relation(fields: [jobId], references: [id])
  userId       String
  user         User                 @relation(fields: [userId], references: [id])
  resumeFileId String
  resumeName   String
  coverNote    String?
  status       JobApplicationStatus @default(APPLIED)
  appliedAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([jobId, userId])
  @@map("job_applications")
}

// ----------------------
// COURSE REVIEWS
// One review per verified enrollment (a CoursePurchase with status SUCCESS)
// — checked at write time, not enforced by a DB constraint, since a
// purchase could in principle be refunded after a review is left.
// ----------------------

model CourseReview {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, userId])
  @@map("course_reviews")
}
